APP_NAME=Research Assistant API
API_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DATABASE_URL=sqlite:///./data/app.db

# Use a long random value (python -c "import secrets; print(secrets.token_urlsafe(48))").
JWT_SECRET_KEY=change-this-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Where the frontend runs. OAuth providers redirect to
# {FRONTEND_URL}/auth/callback/{provider}; register that exact URL with them.
FRONTEND_URL=http://localhost:5173
# The deployed frontend (Cloudflare Pages), e.g. https://my-app-ai.pages.dev. Blank = local only.
HOSTED_FRONTEND_URL=
# Sign in with Google (Google Cloud Console > APIs & Services > Credentials).
# Leave blank to turn it off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with GitHub (GitHub > Settings > Developer settings > OAuth Apps).
# Leave blank to turn it off.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# A second GitHub OAuth App for the hosted frontend (one callback URL per GitHub app).
GITHUB_HOSTED_CLIENT_ID=
GITHUB_HOSTED_CLIENT_SECRET=

# Interactive API docs at /docs. Set false when the API is public (Tailscale Funnel).
API_DOCS_ENABLED=true

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Which LLM answers questions and writes summaries: groq (hosted) or ollama (local).
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys). Never commit a real key.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# "none" turns off Qwen's thinking, which would otherwise spend output tokens.
GROQ_REASONING_EFFORT=none

# Safety limits for development, below Groq's free tier
# (30 req/min, 1,000 req/day, 8,000 tokens/min, 200,000 tokens/day).
# Requests that would pass these are not sent to Groq at all.
GROQ_DAILY_REQUEST_LIMIT=900
GROQ_DAILY_TOKEN_LIMIT=180000
GROQ_MINUTE_REQUEST_LIMIT=25
GROQ_MINUTE_TOKEN_LIMIT=7000

# Warning thresholds (percent of the limits above); warnings never block.
GROQ_DAILY_WARNING_PERCENT=80
GROQ_MINUTE_WARNING_PERCENT=80

# Maximum generated tokens for any Groq call (answers, summaries, analysis).
GROQ_MAX_OUTPUT_TOKENS=700

# Local model, used when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
# Pull it first: `ollama pull qwen2.5:3b`. Blank means qwen2.5:3b.
OLLAMA_MODEL=qwen2.5:3b

# Loaded with sentence-transformers; ~2.3 GB downloads on first use.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDINGS_ENABLED=true
# Search results below this cosine similarity are dropped.
RETRIEVAL_MIN_SCORE=0.40

# Background thread that extracts, chunks and embeds uploaded documents.
PROCESSING_WORKER_ENABLED=true

# A 30-60 minute interview recording is roughly 30-60 MB.
UPLOAD_MAX_AUDIO_SIZE_MB=100
UPLOAD_MAX_VIDEO_SIZE_MB=100
UPLOAD_MAX_DOCUMENT_SIZE_MB=5

# Audio/video transcription (faster-whisper, runs locally).
TRANSCRIPTION_ENABLED=true
# tiny | base | small | medium | large-v3 (small ~ 480 MB, downloaded on first use).
WHISPER_MODEL=small
# auto = GPU if its CUDA 12 libraries load, else CPU. Or: cpu | cuda.
WHISPER_DEVICE=auto
# Blank = int8 on CPU, int8_float16 on GPU.
WHISPER_COMPUTE_TYPE=
# Blank = detect the language. A code such as en or sn skips detection.
WHISPER_LANGUAGE=

PROJECT_NAME_MAX_LENGTH=200
PROJECT_DESCRIPTION_MAX_LENGTH=2000
